#!/usr/bin/env python3
"""hitches - how smoothly the motion in a screen recording plays.

  hitches VIDEO [--from S] [--to S] [--roi X,Y,W,H] [--refresh HZ]

A screen recording from `simctl io recordVideo` or a phone stores a frame only
when the screen changes. Inside a stretch of motion, then, a frame that comes
late is a frame the app failed to draw on time: a hitch. For each stretch of
motion this prints its time, its length, its hitch time ratio (milliseconds
of lateness per second of motion, as Apple's XCTHitchMetric and Instruments
report it: under 5 is smooth, 5-10 is noticeable, over 10 is a stutter) and
its worst frame gap. The ROI, in the video's own pixels, limits what counts
as motion to one part of the screen.
"""
import argparse
import subprocess
import sys

import numpy as np

WIDTH = 96          # frames are compared at this width, in gray
STILL = 0.6         # mean difference, out of 255, under which a frame did not move
QUIET = 0.25        # seconds without motion that end a stretch of it


def frames(video, roi, start, end):
    probe = subprocess.run(
        ["ffprobe", "-v", "error", "-select_streams", "v", "-show_entries", "stream=width,height",
         "-of", "csv=p=0", video], capture_output=True, text=True, check=True).stdout.strip().split(",")
    vw, vh = int(probe[0]), int(probe[1])
    x, y, w, h = roi or (0, 0, vw, vh)
    height = max(2, round(WIDTH * h / w / 2) * 2)
    window = []
    if start is not None:
        window += ["-ss", str(start)]
    if end is not None:
        window += ["-to", str(end)]
    times = subprocess.run(
        ["ffprobe", "-v", "error", "-select_streams", "v", "-show_entries", "frame=pts_time",
         "-of", "csv=p=0", *(["-read_intervals", f"{start or 0}%{end}"] if end else []), video],
        capture_output=True, text=True, check=True).stdout.split()
    times = [float(t.strip(",")) for t in times if t.strip(",") not in ("", "N/A")]
    times = [t for t in times if (start is None or t >= start) and (end is None or t <= end)]
    raw = subprocess.run(
        ["ffmpeg", "-v", "error", *window, "-i", video, "-fps_mode", "passthrough",
         "-vf", f"crop={w}:{h}:{x}:{y},scale={WIDTH}:{height},format=gray",
         "-f", "rawvideo", "-"], capture_output=True, check=True).stdout
    pixels = np.frombuffer(raw, np.uint8).reshape(-1, height, WIDTH).astype(np.int16)
    count = min(len(pixels), len(times))
    return np.array(times[:count]), pixels[:count]


def stretches(times, pixels):
    moved = np.abs(np.diff(pixels, axis=0)).mean(axis=(1, 2)) > STILL
    stretch = []
    for i in np.flatnonzero(moved) + 1:
        if stretch and times[i] - times[stretch[-1]] > QUIET:
            yield stretch
            stretch = []
        if not stretch:
            # The frame before the first that moved is where the motion
            # starts, unless the screen sat still on it.
            stretch = [i - 1] if times[i] - times[i - 1] <= QUIET else []
        stretch.append(i)
    if stretch:
        yield stretch


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("video")
    parser.add_argument("--from", dest="start", type=float)
    parser.add_argument("--to", dest="end", type=float)
    parser.add_argument("--roi", type=lambda s: tuple(int(v) for v in s.split(",")))
    parser.add_argument("--refresh", type=float, default=60)
    args = parser.parse_args()
    times, pixels = frames(args.video, args.roi, args.start, args.end)
    frame = 1 / args.refresh
    total_motion = total_hitch = 0.0
    print(f"{'at s':>8} {'long s':>7} {'frames':>6} {'hitch ms/s':>10} {'worst gap ms':>12}")
    for stretch in stretches(times, pixels):
        t = times[stretch]
        gaps = np.diff(t)
        if len(gaps) < 3:
            continue
        late = np.where(gaps > frame * 1.5, gaps - frame, 0).sum()
        span = t[-1] - t[0]
        total_motion += span
        total_hitch += late
        print(f"{t[0]:8.2f} {span:7.2f} {len(t):6d} {late * 1000 / span:10.1f} {gaps.max() * 1000:12.0f}")
    if total_motion:
        print(f"all motion: {total_motion:.2f} s, hitch time ratio {total_hitch * 1000 / total_motion:.1f} ms/s")


if __name__ == "__main__":
    sys.exit(main())
