#!/bin/bash
# Fail a web page whose touch targets are too small or too close together, read
# on a phone-sized touch screen. The same rules as the iOS check
# (ios/TouchTargets/TouchTargets.swift); lib/touch-targets.mjs says what they are.
# Prints one line per problem and exits 1 when there are any.
#
# Usage: touch-targets [options] URL
#
# Options:
#   -s WIDTHxHEIGHT    Viewport (default: 390x844, an iPhone)
#   -w SECONDS         Wait after load (default: 1)
#   -a USER:PASS       HTTP basic auth
#   -H 'Name: Value'   Extra request header, repeatable (e.g. Authorization)
#   -C 'name=value'    Cookie for the page's origin, repeatable (a session)
#   -m PX              Minimum size (default 44)
#   -g PX              Minimum gap (default 16)
#
# Examples:
#   touch-targets http://localhost:3100/
#   touch-targets -C "session=$(cat /tmp/session)" https://maestro.impulsearc.com/contacts

set -e

TOOL_DIR="$(cd "$(dirname "$0")/.." && pwd)"
WIDTH=390; HEIGHT=844; WAIT=1; AUTH=""; MIN_SIZE=44; MIN_GAP=16
HEADERS=(); COOKIES=()

while getopts "s:w:a:H:C:m:g:" opt; do
  case $opt in
    s) IFS='x' read -r WIDTH HEIGHT <<< "$OPTARG" ;;
    w) WAIT="$OPTARG" ;;
    a) AUTH="$OPTARG" ;;
    H) HEADERS+=("$OPTARG") ;;
    C) COOKIES+=("$OPTARG") ;;
    m) MIN_SIZE="$OPTARG" ;;
    g) MIN_GAP="$OPTARG" ;;
    *) sed -n '2,22p' "$0" >&2; exit 2 ;;
  esac
done
shift $((OPTIND - 1))
URL="$1"
[ -n "$URL" ] || { sed -n '2,22p' "$0" >&2; exit 2; }

. "$TOOL_DIR/lib/chrome.sh"
resolve_chrome || exit 1

export TT_URL="$URL" TT_WIDTH="$WIDTH" TT_HEIGHT="$HEIGHT" TT_WAIT="$WAIT" TT_AUTH="$AUTH"
export TT_MIN_SIZE="$MIN_SIZE" TT_MIN_GAP="$MIN_GAP" TT_CHROME="$CHROME_PATH" TT_HEADLESS="$CHROME_HEADLESS_MODE"
export TT_HEADERS="$(printf '%s\n' "${HEADERS[@]}")" TT_COOKIES="$(printf '%s\n' "${COOKIES[@]}")"

cd "$TOOL_DIR"
node --input-type=module -e "
import puppeteer from 'puppeteer';
import { findProblems } from './lib/touch-targets.mjs';
const env = process.env;
const browser = await puppeteer.launch({
  headless: env.TT_HEADLESS === 'shell' ? 'shell' : true,
  executablePath: env.TT_CHROME,
});
let failed = false;
try {
  const page = await browser.newPage();
  await page.setViewport({ width: Number(env.TT_WIDTH), height: Number(env.TT_HEIGHT),
    hasTouch: true, isMobile: true, deviceScaleFactor: 3 });
  await page.setUserAgent('Mozilla/5.0 (iPhone; CPU iPhone OS 18_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/18.0 Mobile/15E148 Safari/604.1');
  if (env.TT_AUTH) { const [username, ...rest] = env.TT_AUTH.split(':'); await page.authenticate({ username, password: rest.join(':') }); }
  const headers = Object.fromEntries(env.TT_HEADERS.split('\n').filter(Boolean).map(h => { const i = h.indexOf(':'); return [h.slice(0, i).trim(), h.slice(i + 1).trim()]; }));
  if (Object.keys(headers).length) await page.setExtraHTTPHeaders(headers);
  const cookies = env.TT_COOKIES.split('\n').filter(Boolean).map(c => { const i = c.indexOf('='); return { name: c.slice(0, i), value: c.slice(i + 1), url: env.TT_URL }; });
  if (cookies.length) await page.setCookie(...cookies);
  await page.goto(env.TT_URL, { waitUntil: 'networkidle2', timeout: 30000 }).catch(() => {});
  await new Promise(r => setTimeout(r, Number(env.TT_WAIT) * 1000));
  const problems = await page.evaluate(findProblems, { minSize: Number(env.TT_MIN_SIZE), minGap: Number(env.TT_MIN_GAP) });
  for (const p of problems) console.log(p);
  if (problems.length) { console.error(problems.length + ' touch-target problem' + (problems.length === 1 ? '' : 's') + ' on ' + env.TT_URL); failed = true; }
} finally {
  await browser.close();
}
process.exit(failed ? 1 : 0);
"
